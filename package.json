{
  "name": "tech-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "node_modules/node/bin/node node_modules/astro/bin/astro.mjs dev",
    "dev:demo": "node_modules/node/bin/node node_modules/astro/bin/astro.mjs dev --mode demo",
    "build": "node_modules/node/bin/node node_modules/astro/bin/astro.mjs build && npm run verify:output",
    "build:test": "node_modules/node/bin/node node_modules/astro/bin/astro.mjs build --mode test && npm run verify:output -- dist-test && node_modules/node/bin/node --experimental-strip-types scripts/verify-fixture.ts",
    "verify:output": "node_modules/node/bin/node --experimental-strip-types scripts/verify-output.ts",
    "preview": "node_modules/node/bin/node node_modules/astro/bin/astro.mjs preview",
    "check": "node_modules/node/bin/node node_modules/astro/bin/astro.mjs check",
    "test": "node_modules/node/bin/node node_modules/vitest/vitest.mjs run tests/unit",
    "test:e2e": "node_modules/node/bin/node node_modules/playwright/cli.js test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.7",
    "parse5": "7.3.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.15",
    "node": "22.23.3",
    "typescript": "~5.9.3",
    "vitest": "5.0.3"
  }
}
