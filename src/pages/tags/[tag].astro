---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import { groupByTag, type PublishedPost } from '../../lib/taxonomy';
import { withBase } from '../../lib/urls';
export async function getStaticPaths() { return [...groupByTag(await getPublishedPosts())].map(([tag, posts]) => ({ params: { tag }, props: { tag, posts } })); }
interface Props { tag: string; posts: PublishedPost[]; }
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`}><div class="discovery-shell compact-page"><header class="page-intro"><a class="back-link" href={withBase('/tags/')}>← 모든 태그</a><h1>#{tag}</h1><p>{posts.length}개의 기록</p></header>{posts.map(post => <PostCard post={post} />)}</div></BaseLayout>
