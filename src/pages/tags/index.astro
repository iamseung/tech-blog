---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { groupByTag, tagSegment } from '../../lib/taxonomy';
import { withBase } from '../../lib/urls';
const groups = [...groupByTag(await getPublishedPosts())].sort((a, b) => a[0].localeCompare(b[0], 'ko'));
---
<BaseLayout title="태그"><div class="discovery-shell compact-page"><header class="page-intro"><p class="eyebrow">주제별 기록</p><h1>태그</h1><p>관심 있는 주제에서 다음 글을 찾아보세요.</p></header><div class="taxonomy-list">{groups.map(([tag, posts]) => <a href={withBase(`/tags/${encodeURIComponent(tagSegment(tag))}/`)}><span>{tag}</span><span>{posts.length}</span></a>)}</div>{!groups.length && <p class="empty-message">첫 글이 발행되면 태그를 둘러볼 수 있습니다.</p>}</div></BaseLayout>
