---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import { groupBySeries, type PublishedPost } from '../../lib/taxonomy';
import { withBase } from '../../lib/urls';
export async function getStaticPaths() { return [...groupBySeries(await getPublishedPosts())].map(([series, posts]) => ({ params: { series }, props: { series, posts } })); }
interface Props { series: string; posts: PublishedPost[]; }
const { series, posts } = Astro.props;
---
<BaseLayout title={series}><div class="discovery-shell compact-page"><header class="page-intro"><a class="back-link" href={withBase('/series/')}>← 모든 시리즈</a><p class="eyebrow">시리즈</p><h1>{series}</h1><p>{posts.length}개의 글 · 순서대로 읽기</p></header>{posts.map(post => <PostCard post={post} order={post.data.seriesOrder} />)}</div></BaseLayout>
